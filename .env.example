# Database (PostgreSQL) — update user/password/db to match your local install
DATABASE_URL=""

# Auth.js
AUTH_SECRET=""
AUTH_URL=""
AUTH_TRUST_HOST=""

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# UploadThing
UPLOADTHING_TOKEN=""
UPLOADTHING_APP_ID=""

# Web Push (device alerts when the CRM tab is closed)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# App
NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_APP_URL=""
PORT=

# Zoho Books — inbound only (Zoho → CRM). CRM never writes to Zoho.
# Docs: docs/ZOHO_INTEGRATION.md
ZOHO_DC=""
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ORGANIZATION_ID=""
ZOHO_WEBHOOK_SECRET=""
ZOHO_SYNC_ENABLED=""
# Keep false — enables CRM → Zoho writes (not used in production)
ZOHO_OUTBOUND_ENABLED=""
# Soft client limit (Zoho ~100/min). Default 40 leaves headroom.
ZOHO_RATE_LIMIT_PER_MIN=""
ZOHO_MIN_REQUEST_GAP_MS=""
ZOHO_PULL_MAX_PAGES=""
ZOHO_RATE_LIMIT_COOLDOWN_MS=""
ZOHO_WORKER_INTERVAL_MS=""
